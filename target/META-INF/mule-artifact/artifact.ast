-1.0.xsd\"\n): {\n  \"s:Header\": {\n    \"a:Action\" @(\"s:mustUnderstand\": \"1\"): \"Retrieve\",\n    \"a:To\" @(\"s:mustUnderstand\": \"1\"): \"https://\" ++ subdomain ++ \"/Service.asmx\",\n    fueloauth @(\"xmlns\": \"http://exacttarget.com\"): AccessToken\n  },\n  \"s:Body\" @(\n    \"xmlns:xsi\": \"http://www.w3.org/2001/XMLSchema-instance\",\n    \"xmlns:xsd\": \"http://www.w3.org/2001/XMLSchema\"\n  ): {\n    RetrieveRequestMsg @(\"xmlns\": \"http://exacttarget.com/wsdl/partnerAPI\"): {\n      RetrieveRequest: {\n        ObjectType: \"DataExtensionObject[Alertes_Notifications]\",\n        Properties: [\n          \"ContactId\",\n          \"Message1_Mobile\",\n          \"Message2_Mobile\",\n          \"Message3_Mobile\",\n          \"Title_Mobile\",\n          \"TitleCTA_Mobile\",\n          \"UrlCTA_Mobile\",\n          \"LimitDate_Mobile\",\n          \"PublicationDate_Mobile\",\n          \"Message1_Web\",\n          \"Message2_Web\",\n          \"Message3_Web\",\n          \"UrlCTA_Web\",\n          \"TitleCTA_Web\",\n          \"LimitDate_Web\",\n          \"Title_Web\",\n          \"PublishedDate_Web\",\n          \"Type\",\n          \"order\"\n        ],\n        Filter @(\"xsi:type\": \"SimpleFilterPart\"): {\n          Property: \"ContactId\",\n          SimpleOperator: \"equals\",\n          Value: vars.filterVal\n        }\n      }\n    }\n  }\n}\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003chttp:request method\u003d\"POST\" doc:name\u003d\"Get Notification DE1\" doc:id\u003d\"2fb08fbb-69b9-4920-abd1-94d6dfc4fb4d\" url\u003d\"#[\"https://\" ++ Mule::p(\u0027secure::soap.subdomain\u0027) ++ \"/Service.asmx\"]\" sendBodyMode\u003d\"ALWAYS\"\u003e\r\n\u003chttp:body\u003e\u003c![CDATA[\r\n#[%dw 2.0\noutput text/plain\n---\nwrite(payload, \"application/xml\")]\r\n]]\u003e\u003c/http:body\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[\r\n#[output application/java\n---\n{\n\t\"SOAPAction\" :