w.w3.org/2001/XMLSchema\"\n  ): {\n    RetrieveRequestMsg @(\"xmlns\": \"http://exacttarget.com/wsdl/partnerAPI\"): {\n      RetrieveRequest: {\n        ObjectType: \"DataExtensionObject[Alertes_Notifications_One_Time_Day]\",\n        Properties: [\n          \"ContactId\",\n          \"Message1_Mobile\",\n          \"Message2_Mobile\",\n          \"Message3_Mobile\",\n          \"TitleCTA_Mobile\",\n          \"UrlCTA_Mobile\",\n          \"LimitDate_Mobile\",\n          \"PublicationDate_Mobile\",\n          \"Title_Mobile\",\n          \"Message1_Web\",\n          \"Message2_Web\",\n          \"Message3_Web\",\n          \"UrlCTA_Web\",\n          \"TitleCTA_Web\",\n          \"LimitDate_Web\",\n          \"PublishedDate_Web\",\n          \"Title_Web\",\n          \"Type\",\n          \"order\"\n        ],\n        Filter @(\"xsi:type\": \"SimpleFilterPart\"): {\n          Property: \"ContactId\",\n          SimpleOperator: \"equals\",\n          Value: vars.filterVal\n        }\n      }\n    }\n  }\n}\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003chttp:request doc:name\u003d\"Get Notification From DE_One_Time_Day\" doc:id\u003d\"e8bb9cab-5c3b-47f0-ac45-9a82a07e5b91\" method\u003d\"POST\" url\u003d\"#[\"https://\" ++ Mule::p(\u0027secure::soap.subdomain\u0027) ++ \"/Service.asmx\"]\" sendBodyMode\u003d\"ALWAYS\"\u003e\r\n\u003chttp:body\u003e\u003c![CDATA[\r\n#[%dw 2.0\noutput text/plain\n---\nwrite(payload, \"application/xml\")]\r\n]]\u003e\u003c/http:body\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[\r\n#[output application/java\n---\n{\n\t\"SOAPAction\" : \"Retrieve\",\n\t\"Accept\" : \"text/xml\",\n\t\"Content-Type\" : \"text/xml; charset\u003dUTF-8\"\n}]\r\n]]\u003e\u003c/http:headers\u003e\r\n\u003c/http:request\u003e\r\n\u003cee:transform doc:name\u003d\"XML to JSON\" doc:id\u003d\"27192e26-f1c8-44d3-a0b2-cc3e527d5896\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"One_Time\"\u003e\u003c![CDATA[\r\n%dw 2.0\noutput application/json\n\nvar results \u003d payload.Envelope.Body.RetrieveResponseMsg.*Results.Properties map (item) -\u003e\n    (item pluck ((value, key) -\u003e value))\n        reduce (param, acc \u003d {}) -\u003e\n            acc ++ { (param.Name): param.Value }\n---\nresults map {\n    ContactId: $.ContactId,\n    appTitle: $.Title_Mobile,\n    typeNotification: $.Type default \"\",\n    appMsg1: $.Message1_Mobile,\n    appMsg2: $.Message2_Mobile,\n    appMsg3: $.Message3_Mobile,\n    appFormattedMsg: \"\",\n    appLibelleCTA: $.TitleCTA_Mobile,\n    appUrlCTA: $.UrlCTA_Mobile,\n    appDateLimite: $.LimitDate_Mobile,\n    appDatePublicationParcours: $.PublicationDate_Mobile,\n    webTitle: $.Title_Web,\n    webMsg1: $.Message1_Web,\n    webMsg2: $.Message2_Web,\n    webMsg3: $.Message3_Web,\n    webFormattedMsg: \"\",\n    webLibelleCTA: $.TitleCTA_Web,\n    webUrlCTA: $.UrlCTA_Web,\n    webDateLimite: $.LimitDate_Web,\n    webDatePublicationParcours: $.PublishedDate_Web,\n    order: $.order  \n}\r\n]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/route\u003e\r\n\u003c/scatter-gather\u003e\r\n\u003cee:transform doc:name\u003d\"Merge All Notification\" doc:id\u003d\"9e047a9c-a560-4aa8-b25e-6ecb30d4ad28\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[\r\n%dw 2.0\nimport isNumeric from dw::core::Strings\noutput application/json\nvar allNotifs \u003d (vars.global_Notif default [] ++ vars.One_Time default []) distinctBy $\nvar Priority \u003d (allNotifs filter ((item, index) -\u003e isNumeric(item.order) and (item.order) \u003e\u003d 1)) orderBy ((item, index) -\u003e item.order)\n\nvar global \u003d (Priority ++ allNotifs) distinctBy $\n---\nglobal\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u