\n]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/route\u003e\r\n\u003c/scatter-gather\u003e\r\n\u003cee:transform doc:name\u003d\"Merge All Notification\" doc:id\u003d\"9e047a9c-a560-4aa8-b25e-6ecb30d4ad28\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[\r\n%dw 2.0\nimport isNumeric from dw::core::Strings\noutput application/json\nvar allNotifs \u003d (vars.global_Notif default [] ++ vars.One_Time default []) distinctBy $\nvar Priority \u003d (allNotifs filter ((item, index) -\u003e isNumeric(item.order) and (item.order) \u003e\u003d 1)) orderBy ((item, index) -\u003e item.order)\n\nvar global \u003d (Priority ++ allNotifs) distinctBy $\n---\nglobal\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Display Payload\" doc:id\u003d\"417f7d40-52b4-48ae-a6fb-c4f74f6e475b\" message\u003d\"#[payload]\"\u003e\u003c/logger\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":10},"parameters":[{"unresolvedValue":"get-all-mkg-notifications","metadata":{"docAttributes":{"id":"bb1bc682-e5af-427f-8ff7-3f1d872fc576"},"endColumn":13,"endLine":257,"fileName":"get-all-mkg-notifications.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":10},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":10},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":257},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":92},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":257}},"sourceCode":"\u003csub-flow name\u003d\"get-all-mkg-notifications\" doc:id\u003d\"bb1bc682-e5af-427f-8ff7-3f1d872fc576\"\u003e\r\n\u003chttp:request met