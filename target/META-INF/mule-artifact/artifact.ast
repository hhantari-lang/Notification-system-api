oap.subdomain\u0027)\nvar AccessToken \u003d vars.token\n---\n\"s:Envelope\" @(\n  \"xmlns:s\": \"http://www.w3.org/2003/05/soap-envelope\",\n  \"xmlns:a\": \"http://schemas.xmlsoap.org/ws/2004/08/addressing\",\n  \"xmlns:u\": \"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd\"\n): {\n  \"s:Header\": {\n    \"a:Action\" @(\"s:mustUnderstand\": \"1\"): \"Retrieve\",\n    \"a:To\" @(\"s:mustUnderstand\": \"1\"): \"https://\" ++ subdomain ++ \"/Service.asmx\",\n    fueloauth @(\"xmlns\": \"http://exacttarget.com\"): AccessToken\n  },\n  \"s:Body\" @(\n    \"xmlns:xsi\": \"http://www.w3.org/2001/XMLSchema-instance\",\n    \"xmlns:xsd\": \"http://www.w3.org/2001/XMLSchema\"\n  ): {\n    RetrieveRequestMsg @(\"xmlns\": \"http://exacttarget.com/wsdl/partnerAPI\"): {\n      RetrieveRequest: {\n        ObjectType: \"DataExtensionObject[Alertes_Notifications]\",\n        Properties: [\n          \"ContactId\",\n          \"Message1_Mobile\",\n          \"Message2_Mobile\",\n          \"Message3_Mobile\",\n          \"Title_Mobile\",\n          \"TitleCTA_Mobile\",\n          \"UrlCTA_Mobile\",\n          \"LimitDate_Mobile\",\n          \"PublicationDate_Mobile\",\n          \"Message1_Web\",\n          \"Message2_Web\",\n          \"Message3_Web\",\n          \"UrlCTA_Web\",\n          \"TitleCTA_Web\",\n          \"LimitDate_Web\",\n          \"Title_Web\",\n          \"PublishedDate_Web\",\n          \"Type\",\n          \"order\"\n        ],\n        Filter @(\"xsi:type\": \"SimpleFilterPart\"): {\n          Property: \"ContactId\",\n          SimpleOperator: \"equals\",\n          Value: vars.filterVal\n        }\n      }\n    }\n  }\n}\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003chttp:request method\u003d\"POST\" doc:name\u003d\"Get Notification DE1\" doc:id\u003d\"2fb08fbb-69b9-4920-abd1-94d6dfc4fb4d\" url\u003d\"#[\"https://\" ++ Mule::p(\u0027secure::soap.subdomain\u0027) ++ \"/Service.asmx\"]\" sendBodyMode\u003d\"ALWAYS\"\u003e\r\n\u003chttp:body\u003e\u003c![CDATA[\r\n#[%dw 2.0\noutput text/plain\n---\nwrite(payload, \"application/xml\")]\r\n]]\u003e\u003c/http:body\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[\r\n#[output application/java\n---\n{\n\t\"SOAPAction\" : \"Retrieve\",\n\t\"Accept\" : \"text/xml\",\n\t\"Content-Type\" : \"text/xml; charset\u003dUTF-8\"\n}]\r\n]]\u003e\u003c/http:headers\u003e\r\n\u003c/http:request\u003e\r\n\u003cee:transform doc:name\u003d\"XML to JSON\" doc:id\u003d\"6d675477-93fe-46f8-af9d-4264edfb29aa\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"global_Notif\"\u003e\u003c![CDATA[\r\n%dw 2.0\noutput application/json\n\nvar results \u003d payload.Envelope.Body.RetrieveResponseMsg.*Results.Properties map (item) -\u003e\n    (item pluck ((value, key) -\u003e value))\n        reduce (param, acc \u003d {}) -\u003e\n            acc ++ { (param.Name): param.Value }\n---\nresults map {\n    ContactId: $.ContactId,\n    appTitle: $.Title_Mobile,\n    typeNotification: $.Type default \"\",\n    appMsg1: $.Message1_Mobile,\n    appMsg2: $.Message2_Mobile,\n    appMsg3: $.Message3_Mobile,\n    appFormattedMsg: \"\",\n    appLibelleCTA: $.TitleCTA_Mobile,\n    appUrlCTA: $.UrlCTA_Mobile,\n    appDateLimite: $.LimitDate_Mobile,\n    appDatePublicationParcours: $.PublicationDate_Mobile,\n    webTitle: $.Title_Web,\n    webMsg1: $.Message1_Web,\n    webMsg2: $.Message2_Web,\n    webMsg3: $.Message3_Web,\n    webFormattedMsg: \"\",\n    webLibelleCTA: $.TitleCTA_Web,\n    webUrlCTA: $.UrlCTA_Web,\n    webDateLimite: $.LimitDate_Web,\n    webDatePublicationParcours: $.PublishedDate_Web,\n    order: $.order \n}\r\n]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/route\u003e\r\n\u003croute\u003e\r\n\u003cee:transform doc:name\u003d\"Build Request For DE_One_Time_Day\" doc:id\u003d